# C++ source of desktop_identity() (architecture-m3.md 15.12), run in script mode after
# SourceDigest.cmake:
#   cmake -DDIGEST_FILE=<desktop_digest.txt> -DOUTPUT=<desktop_identity.cpp> -P DesktopIdentity.cmake
# DIGEST_FILE holds "<version> <digest>". OUTPUT is rewritten only when its content changes.
foreach(required DIGEST_FILE OUTPUT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "DesktopIdentity.cmake: ${required} is not defined")
  endif()
endforeach()

file(STRINGS "${DIGEST_FILE}" digest_line LIMIT_COUNT 1)
if(NOT digest_line MATCHES "^([^ ]+) ([0-9a-f]+)$")
  message(FATAL_ERROR "DesktopIdentity.cmake: no version and digest in ${DIGEST_FILE}")
endif()
set(version_text "${CMAKE_MATCH_1}")
set(digest "${CMAKE_MATCH_2}")

set(text "// Generated by cmake/DesktopIdentity.cmake. Do not edit.
#include \"core/identity.hpp\"

namespace sinus::desktop::core {

ItemIdentity desktop_identity() noexcept {
  return ItemIdentity{\"${version_text}\", \"${digest}\"};
}

}  // namespace sinus::desktop::core
")
set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUTPUT}" "${text}")
endif()
