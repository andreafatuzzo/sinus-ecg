# Compiler options of the desktop application (architecture-m3.md 15.15, ADR 0007; OP-057).
foreach(forbidden -ffast-math -Ofast -funsafe-math-optimizations -ffinite-math-only
                  -fassociative-math)
  string(FIND "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_DEBUG} ${CMAKE_CXX_FLAGS_RELEASE}"
         "${forbidden}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "CMAKE_CXX_FLAGS contains ${forbidden}: not allowed (OP-057)")
  endif()
endforeach()

# The warnings of the library (libs/sinus-dsp/cmake/Flags.cmake), as errors.
set(SINUS_DESKTOP_WARNINGS
  -Wall -Wextra -Wpedantic -Wconversion -Wsign-conversion -Wdouble-promotion
  -Wfloat-conversion -Wshadow -Wcast-align -Wold-style-cast -Wnon-virtual-dtor
  -Woverloaded-virtual -Wnull-dereference -Wimplicit-fallthrough -Wundef -Werror)
if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
  list(APPEND SINUS_DESKTOP_WARNINGS -Wduplicated-cond -Wlogical-op -Wuseless-cast)
endif()

# core: every rule of ADR 0007, no exceptions and no RTTI.
function(sinus_desktop_apply_core_flags target)
  target_compile_options(${target} PRIVATE -fno-exceptions -fno-rtti -ffp-contract=off
                                           ${SINUS_DESKTOP_WARNINGS})
endfunction()

# io, ui, app: exceptions off, RTTI on (Qt is built with it). The target gets the relaxed warnings
# of the tests, which also reach the files generated by moc; the target's own sources get every
# warning. Call it in the folder that defines the target (source properties are per folder).
function(sinus_desktop_apply_qt_flags target)
  target_compile_options(${target} PRIVATE -fno-exceptions -ffp-contract=off -Wall -Wextra
                                           -Werror)
  get_target_property(own_sources ${target} SOURCES)
  set_source_files_properties(${own_sources} TARGET_DIRECTORY ${target} PROPERTIES
                              COMPILE_OPTIONS "${SINUS_DESKTOP_WARNINGS}")
  # moc's output is not clang-tidy'd (architecture-m3.md 15.15).
  get_target_property(binary_dir ${target} BINARY_DIR)
  set_source_files_properties("${binary_dir}/${target}_autogen/mocs_compilation.cpp"
                              TARGET_DIRECTORY ${target} PROPERTIES SKIP_LINTING ON)
endfunction()

# Tests.
function(sinus_desktop_apply_test_flags target)
  target_compile_options(${target} PRIVATE -ffp-contract=off -Wall -Wextra -Werror)
endfunction()

# clang-tidy of the tools project (tools/cpp, first on PATH through uv run), as the library's.
function(sinus_desktop_tidy_command out_var)
  find_program(SINUS_DESKTOP_CLANG_TIDY NAMES clang-tidy REQUIRED)
  # -Wno-unknown-warning-option: the GCC-only warnings are unknown to clang-tidy.
  # No --config-file: clang-tidy reads the .clang-tidy of each source folder (src/io, src/ui) and
  # its parents (desktop, repository root).
  set(command "${SINUS_DESKTOP_CLANG_TIDY}"
      "--extra-arg=-Wno-unknown-warning-option")
  if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    # On Windows the pinned clang-tidy assumes the MSVC target: it is given the compiler's target
    # and include directories (not its resource directory), as in libs/sinus-dsp/CMakeLists.txt.
    execute_process(COMMAND ${CMAKE_CXX_COMPILER} -dumpmachine OUTPUT_VARIABLE target_triple
                    OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(target_triple)
      list(APPEND command "--extra-arg=--target=${target_triple}")
    endif()
    execute_process(COMMAND ${CMAKE_CXX_COMPILER} -std=c++17 -E -v -x c++ -
                    INPUT_FILE "${PROJECT_SOURCE_DIR}/VERSION"
                    OUTPUT_QUIET ERROR_VARIABLE search)
    string(REPLACE "\r" "" search "${search}")
    string(REGEX REPLACE "^.*#include <[.][.][.]> search starts here:\n" "" search "${search}")
    string(REGEX REPLACE "\nEnd of search list[.].*$" "" search "${search}")
    string(REPLACE "\n" ";" search "${search}")
    foreach(dir IN LISTS search)
      string(STRIP "${dir}" dir)
      if(dir AND NOT dir MATCHES "/lib/clang/")
        list(APPEND command "--extra-arg=-isystem${dir}")
      endif()
    endforeach()
  endif()
  set(${out_var} "${command}" PARENT_SCOPE)
endfunction()
