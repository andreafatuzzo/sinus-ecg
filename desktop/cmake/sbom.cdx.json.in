{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "type": "application",
      "bom-ref": "sinus-desktop",
      "name": "sinus-desktop",
      "version": "@SBOM_VERSION@",
      "licenses": [
        { "license": { "id": "Apache-2.0" } }
      ],
      "properties": [
        { "name": "sinus:source-sha256", "value": "@SBOM_SOURCE_SHA256@" },
        { "name": "sinus:build-target", "value": "@SBOM_BUILD_TARGET@" }
      ]
    }
  },
  "components": [
    {
      "type": "library",
      "bom-ref": "sinus-dsp",
      "name": "sinus-dsp",
      "version": "@SBOM_LIBRARY_VERSION@",
      "licenses": [
        { "license": { "id": "Apache-2.0" } }
      ],
      "properties": [
        { "name": "sinus:source-sha256", "value": "@SBOM_LIBRARY_SHA256@" }
      ]
    },
    {
      "type": "framework",
      "bom-ref": "qt-core",
      "supplier": { "name": "The Qt Company" },
      "name": "Qt Core",
      "version": "@SBOM_QT_VERSION@",
      "licenses": [
        { "license": { "id": "LGPL-3.0-only" } }
      ],
      "cpe": "cpe:2.3:a:qt:qt:@SBOM_QT_VERSION@:*:*:*:*:*:*:*"
    },
    {
      "type": "framework",
      "bom-ref": "qt-gui",
      "supplier": { "name": "The Qt Company" },
      "name": "Qt GUI",
      "version": "@SBOM_QT_VERSION@",
      "licenses": [
        { "license": { "id": "LGPL-3.0-only" } }
      ],
      "cpe": "cpe:2.3:a:qt:qt:@SBOM_QT_VERSION@:*:*:*:*:*:*:*"
    },
    {
      "type": "framework",
      "bom-ref": "qt-widgets",
      "supplier": { "name": "The Qt Company" },
      "name": "Qt Widgets",
      "version": "@SBOM_QT_VERSION@",
      "licenses": [
        { "license": { "id": "LGPL-3.0-only" } }
      ],
      "cpe": "cpe:2.3:a:qt:qt:@SBOM_QT_VERSION@:*:*:*:*:*:*:*"
    },
    {
      "type": "framework",
      "bom-ref": "qt-network",
      "supplier": { "name": "The Qt Company" },
      "name": "Qt Network",
      "version": "@SBOM_QT_VERSION@",
      "licenses": [
        { "license": { "id": "LGPL-3.0-only" } }
      ],
      "cpe": "cpe:2.3:a:qt:qt:@SBOM_QT_VERSION@:*:*:*:*:*:*:*"
    },
    {
      "type": "library",
      "bom-ref": "toolchain-runtime",
      "name": "@SBOM_RUNTIME_NAME@",
      "version": "@SBOM_COMPILER_VERSION@",
      "description": "Runtime libraries of the toolchain that built the application"
    }
  ]
}
