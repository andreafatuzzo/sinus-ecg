# The desktop application's additions to the base configuration of the repository root (ADR 0007,
# architecture-m3.md 15.15). core keeps every check; the Qt layers have their own .clang-tidy in
# src/io and src/ui. Files generated by moc and the generated identity are excluded by the build
# (SKIP_LINTING); Qt's headers are system headers and are not checked.
InheritParentConfig: true
# Both separators: on Windows clang reports paths with '\'.
HeaderFilterRegex: '.*[/\\]desktop[/\\](src|tests)[/\\].*'
