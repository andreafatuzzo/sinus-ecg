# Identity of a C++ item (architecture-m2.md 14.15, architecture-m3.md 15.12), run in script mode:
#   cmake -DROOT=<folder that contains the item> -DITEM=<item folder name> [-DFOLDERS=<folders>]
#         -DVERSION_FILE=<VERSION> [-DOUTPUT=<identity.cpp>] [-DDIGEST_FILE=<digest.txt>]
#         -P SourceDigest.cmake
# Digest: SHA-256 of the manifest of every regular file under <ROOT>/<ITEM>/<folder>, for each
# folder of FOLDERS (a CMake list, default "include;src"; inside a COMMAND write the separator as
# \;), with no path component starting with '.', named by its path relative to ROOT, sorted in
# code-point order, CR LF replaced by LF, one line "<sha256>  <name>" per file.
# OUTPUT receives the C++ source of library_identity() (the library); DIGEST_FILE receives the
# text "<version> <digest>" and a new line. Each file is rewritten only when its content changes.
if(NOT DEFINED FOLDERS)
  set(FOLDERS include src)
endif()
file(STRINGS "${VERSION_FILE}" version_line LIMIT_COUNT 1)
string(STRIP "${version_line}" version_text)

set(names "")
foreach(dir IN LISTS FOLDERS)
  file(GLOB_RECURSE found RELATIVE "${ROOT}" "${ROOT}/${ITEM}/${dir}/*")
  foreach(name IN LISTS found)
    if(NOT name MATCHES "(^|/)\\." AND NOT IS_DIRECTORY "${ROOT}/${name}")
      list(APPEND names "${name}")
    endif()
  endforeach()
endforeach()
list(SORT names COMPARE STRING CASE SENSITIVE)

set(manifest "")
foreach(name IN LISTS names)
  file(READ "${ROOT}/${name}" content)
  string(REPLACE "\r\n" "\n" content "${content}")
  string(SHA256 file_digest "${content}")
  string(APPEND manifest "${file_digest}  ${name}\n")
endforeach()
string(SHA256 digest "${manifest}")

# Writes the text to the path only when the content differs.
function(write_if_changed path text)
  set(old "")
  if(EXISTS "${path}")
    file(READ "${path}" old)
  endif()
  if(NOT old STREQUAL text)
    get_filename_component(out_dir "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${out_dir}")
    file(WRITE "${path}" "${text}")
  endif()
endfunction()

if(DEFINED OUTPUT)
  set(text "// Generated by cmake/SourceDigest.cmake. Do not edit.
#include \"sinus/dsp/version.hpp\"

namespace sinus::dsp {

LibraryIdentity library_identity() noexcept {
  return LibraryIdentity{\"${version_text}\", \"${digest}\"};
}

}  // namespace sinus::dsp
")
  write_if_changed("${OUTPUT}" "${text}")
endif()
if(DEFINED DIGEST_FILE)
  write_if_changed("${DIGEST_FILE}" "${version_text} ${digest}\n")
endif()
