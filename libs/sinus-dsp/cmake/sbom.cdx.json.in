{
  "bomFormat": "CycloneDX",
  "specVersion": "1.6",
  "version": 1,
  "metadata": {
    "component": {
      "type": "library",
      "bom-ref": "sinus-dsp",
      "name": "sinus-dsp",
      "version": "@SBOM_VERSION@",
      "licenses": [
        { "license": { "id": "Apache-2.0" } }
      ],
      "properties": [
        { "name": "sinus:source-sha256", "value": "@SBOM_SOURCE_SHA256@" },
        { "name": "sinus:build-target", "value": "@SBOM_BUILD_TARGET@" }
      ]
    }
  },
  "components": [
    {
      "type": "library",
      "bom-ref": "toolchain-runtime",
      "name": "@SBOM_RUNTIME_NAME@",
      "version": "@SBOM_COMPILER_VERSION@",
      "description": "Runtime libraries of the toolchain that built the library"
    }
  ]
}
