# The library's own additions to the base configuration of the repository root (ADR 0007).
InheritParentConfig: true
# Both separators: on Windows clang reports include\sinus/dsp/x.hpp, which a '/'-only regex misses.
HeaderFilterRegex: '.*[/\\]libs[/\\]sinus-dsp[/\\](include|src|verification|harness)[/\\].*'
